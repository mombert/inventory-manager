# html5-qrcode ships source maps whose relative paths are off by one
# directory (they point at node_modules/src/*.ts instead of
# node_modules/html5-qrcode/src/*.ts), so webpack logs a warning for
# every file it cannot resolve. Turning off production source maps
# silences them, speeds up the build, and keeps the app's own source
# out of the deployed bundle. Development (npm start) is unaffected —
# source maps still work there.
GENERATE_SOURCEMAP=false
